<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Doit matcher le runtime .NET embarqué par BepInEx IL2CPP dans le jeu
         (confirmé dans BepInEx/LogOutput.log : "Runtime information: .NET 6.0.7"). -->
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Désactivé : les DLL interop IL2CPP embarquent leur propre
         System.Runtime.CompilerServices.NullableAttribute incomplet, ce qui
         fait échouer la compilation (CS0656) dès que Nullable est actif et
         qu'une de ces DLL est référencée. -->
    <Nullable>disable</Nullable>
    <AssemblyName>BigWalkArchipelago</AssemblyName>
    <RootNamespace>BigWalkArchipelago</RootNamespace>

    <!-- Les <Reference> ci-dessous portent toutes <Private>false</Private> :
         elles existent déjà dans BepInEx/ et BepInEx/interop/ au runtime et ne
         sont jamais copiées. Ce flag ne concerne donc que les PackageReference
         NuGet (le client Archipelago), qui eux DOIVENT atterrir à côté du
         plugin — BepInEx résout les dépendances d'un plugin dans son propre
         dossier. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <EnableDefaultItems>true</EnableDefaultItems>

    <!-- net6.0 est hors support côté SDK, mais c'est le runtime qu'embarque
         BepInEx dans le jeu : l'avertissement n'a rien à nous apprendre. -->
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <!-- Client Archipelago officiel (C#). Aucune dépendance NuGet : le paquet
         embarque son propre Newtonsoft.Json dans lib/net6.0/, donc exactement
         2 DLL à déployer à côté du plugin (voir ../README.md). -->
    <PackageReference Include="Archipelago.MultiClient.Net" Version="6.7.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- BepInEx core (IL2CPP) + Harmony — copiées depuis <jeu>/BepInEx/core/
         (voir lib/README.md pour la provenance exacte de chaque DLL). -->
    <Reference Include="BepInEx.Core">
      <HintPath>..\lib\BepInEx.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx.Unity.IL2CPP">
      <HintPath>..\lib\BepInEx.Unity.IL2CPP.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>..\lib\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- Interop du jeu (générée par Il2CppInterop, PAS le dummy Il2CppInspector) -->
    <Reference Include="Assembly-CSharp">
      <HintPath>..\lib\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Mirror">
      <HintPath>..\lib\Mirror.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>..\lib\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>..\lib\Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>..\lib\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Physics.Raycast, pour poser les gourdes restaurées sur du vrai sol
         plutôt qu'à un décalage calculé à l'aveugle (cf. ReceivedItemSpawner). -->
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>..\lib\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2Cppmscorlib">
      <HintPath>..\lib\Il2Cppmscorlib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppInterop.Runtime">
      <HintPath>..\lib\Il2CppInterop.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
